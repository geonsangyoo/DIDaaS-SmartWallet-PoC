# Run `bun run generate-keys` to generate these three values
PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
KEY_ID="your-key-uuid"

# Google OAuth client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-id.apps.googleusercontent.com"

# Must match "AUD Value" set in thirdweb dashboard → In-App Wallet → Custom JWT
JWT_AUDIENCE="didaas-smartwallet"

FRONTEND_URL="http://localhost:3000"
PORT=3001

# ── Verification 2: Remote Signer + AI Agent ──────────────────────────────────
# ZeroDev project ID (same value as NEXT_PUBLIC_ZERODEV_PROJECT_ID on frontend).
# Used by the backend to submit UserOps via the ZeroDev bundler + paymaster.
ZERODEV_PROJECT_ID="your-zerodev-project-id"

# ThirdWeb secret key (get from dashboard.thirdweb.com → Settings → API Keys → Secret Key).
# Required to create the ERC-4337 smart wallet for the asset owner (A) on the backend.
THIRDWEB_SECRET_KEY="your-secret-key"

# Private key of the EOA signer for the ThirdWeb smart wallet A.
# The actual A address is the ThirdWeb ERC-4337 smart wallet derived from this EOA.
# Phase 2 step 1: backend sends JPYC from A → B (Kernel SCW) via gasless UserOp.
# Address is exposed via GET /asset-owner/address.
ASSET_OWNER_PRIVATE_KEY="0x..."

# Private key of the server-side EOA that acts as the session-key delegate (wallet D).
# Phase 2 step 2: this signer executes the session-key UserOp B → C.
# Generate a fresh throwaway key: `cast wallet new` or `openssl rand -hex 32` → prepend 0x
# The corresponding address is exposed via GET /remote-signer/address so the
# Owner can grant a session key to it.
REMOTE_SIGNER_PRIVATE_KEY="0x..."
